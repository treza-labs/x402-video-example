# A Base wallet private key holding a few USDC. Payments are EIP-3009
# transferWithAuthorization, so no ETH is needed for gas.
# Use a small, dedicated hot wallet, never a main one.
PRIVATE_KEY=0x...

# Or pay on Solana instead: a Solana wallet's base58 secret key (the 64-byte
# export from Phantom and most wallets) holding a few USDC. No SOL is needed:
# the facilitator pays the network fee. When set, this is used instead of
# PRIVATE_KEY.
# SOLANA_PRIVATE_KEY=
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # optional, the client reads the USDC mint from it

# Optional overrides
# X402_VIDEO_ENDPOINT=https://www.trezalabs.com/api/x402/video
# Unset CLIP_SECONDS and CLIP_MODEL are left out of the request, so the
# endpoint picks its defaults: minimax-h3 at 5 seconds, or with
# CLIP_IMAGE_URL the cheapest model that takes an image at your length.
# CLIP_SECONDS=5        # a length the model sells: 5, 10 or 15 on minimax-h3,
#                       # kling-3.0, kling-3.0-pro, seedance-2.5; 4, 6 or 8 on
#                       # veo-3.1-lite, veo-3.1-fast, veo-3.1; 5 or 10 on wan-2.7
# CLIP_ASPECT=16:9      # 16:9 or 9:16
# CLIP_MODEL=minimax-h3 # minimax-h3 (default), veo-3.1-lite, wan-2.7,
#                       # veo-3.1-fast, kling-3.0, kling-3.0-pro, seedance-2.5, veo-3.1
# CLIP_IMAGE_URL=https://example.com/first-frame.jpg
#                       # optional first frame: a public https JPEG, PNG or WebP
#                       # up to 10 MB. Leave CLIP_MODEL unset and the model is
#                       # picked for you (wan-2.7 for 5 or 10 seconds, kling-3.0
#                       # for 15, veo-3.1-lite otherwise); minimax-h3 cannot take one.
