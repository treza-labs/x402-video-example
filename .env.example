# A Base wallet private key holding a few USDC. Payments are EIP-3009
# transferWithAuthorization, so no ETH is needed for gas.
# Use a small, dedicated hot wallet, never a main one.
PRIVATE_KEY=0x...

# Optional overrides
# X402_VIDEO_ENDPOINT=https://www.trezalabs.com/api/x402/video
# CLIP_SECONDS=5        # 5, 10, or 15
# CLIP_ASPECT=16:9      # 16:9 or 9:16
# CLIP_MODEL=minimax-h3 # minimax-h3 (default) or seedance-2.5
